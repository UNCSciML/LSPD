# Checkpoint serialization is source code, not a saved model. Override any
# broader checkpoint-directory ignore rule inherited from a parent checkout.
!/verl/verl/utils/checkpoint/
!/verl/verl/utils/checkpoint/*.py
!/verl/verl/third_party/torch/distributed/checkpoint/
!/verl/verl/third_party/torch/distributed/checkpoint/*.py
